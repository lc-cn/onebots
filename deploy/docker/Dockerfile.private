# syntax=docker/dockerfile:1
# 此镜像包含私有模块代码，只能推送到你有权使用的私有镜像仓库。
ARG ONEBOTS_BASE=ghcr.io/lc-cn/onebots:master
FROM ${ONEBOTS_BASE}
USER root
ARG ONEBOTS_PRIVATE_EXTENSIONS=icqq
RUN node /app/scripts/docker-extension-release.mjs init /opt/onebots-private baked
# tmpfs 确保即使构建被强制中断，临时认证副本也不会进入构建层。
RUN --mount=type=secret,id=npmrc,required=true,target=/run/secrets/npmrc \
    --mount=type=tmpfs,target=/tmp \
    node /app/scripts/docker-extension-installer.mjs download /opt/onebots-private/releases/baked baked ${ONEBOTS_PRIVATE_EXTENSIONS}
USER node
ARG ONEBOTS_ALLOW_BUILD=
RUN --network=none --mount=type=tmpfs,target=/tmp \
    node /app/scripts/docker-extension-installer.mjs verify /opt/onebots-private/releases/baked baked ${ONEBOTS_ALLOW_BUILD}
USER root
RUN node /app/scripts/docker-extension-release.mjs activate /opt/onebots-private baked \
    && node /app/scripts/docker-extension-release.mjs unlock /opt/onebots-private baked
ENV ONEBOTS_EXTENSION_ROOT=/opt/onebots-private
