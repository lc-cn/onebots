# OneBots HF 入口兼容模板；HF 存储 provider 尚未验收，不能视为已支持的平台部署。
# 基于官方镜像，仅增加 HF 要求的端口 7860 与入口脚本，无需在 HF 上从源码构建（无需 GH_PKG_TOKEN）
# 在 HF 创建 Space 时选择 Docker，将本文件命名为 Dockerfile 或通过 Build 设置指定
# 文档：https://huggingface.co/docs/hub/spaces-sdks-docker
# 必须分别持久挂载 /data 与 /var/lib/onebots-authority，且提供可靠本地锁/物理身份。
# Storage Bucket/FUSE 不能仅凭路径存在视为满足；本机双卷测试不代表 HF 实机验收。
# 首期 HF_REPO_ID 非空会在任何下载/目录初始化前明确拒绝；自动恢复后续补齐。

ARG ONEBOTS_BASE_IMAGE=ghcr.io/lc-cn/onebots:master
FROM ${ONEBOTS_BASE_IMAGE}

# Hugging Face Spaces 默认暴露 7860，由 PORT 环境变量传入
ENV PORT=7860
EXPOSE 7860

COPY docker-entrypoint-hf.sh /docker-entrypoint-hf.sh
COPY docker-authority.sh /app/docker-authority.sh
COPY docker-workspace.sh /app/docker-workspace.sh
COPY --chown=node:node scripts/hf-repository-download.mjs /app/scripts/hf-repository-download.mjs
COPY --chown=node:node scripts/hf-data-archive-restore.mjs /app/scripts/hf-data-archive-restore.mjs
RUN chmod +x /docker-entrypoint-hf.sh
ENTRYPOINT ["/docker-entrypoint-hf.sh"]

# 与标准 Docker 共用管理服务，管理端口不写入业务配置。
CMD ["serve", "--data-dir", "/data", "--authority-dir", "/var/lib/onebots-authority/authority", "--host", "0.0.0.0"]
