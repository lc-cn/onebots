{
  "name": "onebots-monorepo",
  "version": "0.5.0",
  "description": "IMHelper - 统一的消息助手，支持多种IM平台和协议",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:rest",
    "build:packages": "pnpm --filter='./packages/*' --workspace-concurrency=1 build",
    "build:rest": "pnpm --filter='./protocols/*/*' --filter='./adapters/*' --filter=@onebots/docs --filter=onebots-dev build",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter=onebots-dev dev",
    "test:ws": "pnpm --filter=onebots-dev test:ws",
    "web:dev": "pnpm -r --filter=@onebots/web dev",
    "sdk:dev": "pnpm --filter=onebots-dev sdk:dev",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "interop:nonebot": "node scripts/interop-nonebot.mjs",
    "interop:zhin": "node scripts/interop-zhin.mjs",
    "interop:alemonjs": "node scripts/interop-alemonjs.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check ./**/*.{ts,js}",
    "format:fix": "prettier --write ./**/*.{ts,js,md}",
    "docs:dev": "vitepress dev docs --port 8989",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "create:adapter": "node scripts/create-adapter.mjs",
    "catalog:capabilities": "node scripts/generate-extension-capability-catalog.mjs",
    "catalog:capabilities:check": "node scripts/generate-extension-capability-catalog.mjs --check",
    "readme:capabilities": "node scripts/generate-readme-api-matrix.mjs",
    "readme:capabilities:check": "node scripts/generate-readme-api-matrix.mjs --check",
    "packages:pack:check": "node scripts/verify-publish-packages.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm catalog:capabilities",
    "changeset:publish": "changeset publish",
    "bump": "pnpm changeset:version",
    "pub": "changeset publish"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lc-cn/onebots.git"
  },
  "keywords": [
    "onebot",
    "qq",
    "wechat",
    "dingtalk",
    "cq-http",
    "multi-protocol"
  ],
  "author": "凉菜",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lc-cn/onebots/issues"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "protocols/*/*",
    "docs",
    "development"
  ],
  "homepage": "https://github.com/lc-cn/onebots#readme",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "d3-sankey": "^0.12.3",
    "eslint": "^10.5.0",
    "koa-static": "^5.0.0",
    "prettier": "^3.8.1",
    "socks-proxy-agent": "^8.0.5",
    "typescript": "catalog:",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "ws": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "glob": "^10.0.0",
      "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
      "axios": "^1.19.0",
      "ws": "^8.21.3",
      "nodemailer": "^9.0.5",
      "form-data": "^4.0.6",
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "semver": "^7.8.5",
      "path-to-regexp": "^8.4.2",
      "linkify-it": "^5.0.1",
      "js-yaml": "^4.3.1",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "ip-address": "^10.3.1",
      "brace-expansion": "^5.0.9",
      "immutable": "^5.1.9",
      "nanoid": "^3.3.18",
      "@protobufjs/utf8": "^1.1.2",
      "protobufjs": "^7.6.3",
      "dompurify": "^3.4.14",
      "esbuild": "^0.25.0",
      "mermaid": "^11.17.0",
      "postcss": "^8.5.26",
      "vitepress>vite": "^7.3.6",
      "vitepress>@vitejs/plugin-vue": "^6.0.8"
    },
    "onlyBuiltDependencies": [
      "@karinjs/node-pty",
      "esbuild",
      "protobufjs"
    ]
  }
}
