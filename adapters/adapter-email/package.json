{
  "name": "@onebots/adapter-email",
  "version": "3.0.8",
  "description": "onebots 邮件适配器",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "rm -rf lib *.tsbuildinfo"
  },
  "keywords": [
    "onebots",
    "email",
    "smtp",
    "imap",
    "adapter"
  ],
  "author": "凉菜",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "!lib/**/*.spec.*",
    "!lib/**/*.test.*",
    "!lib/**/__tests__/**"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "tsc-alias": "latest",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "onebots": "workspace:*"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "imapflow": "^1.7.6",
    "mailparser": "^3.6.5"
  },
  "optionalDependencies": {
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lc-cn/onebots.git"
  }
}
