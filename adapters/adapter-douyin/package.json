{
    "name": "@onebots/adapter-douyin",
    "version": "1.0.0",
    "description": "OneBots 抖音 IM 适配器，基于 douyin-im",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "build": "node ../../scripts/clean-package.mjs ts && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "clean": "node ../../scripts/clean-package.mjs lib"
    },
    "keywords": [
        "onebots",
        "douyin",
        "adapter",
        "im",
        "bot"
    ],
    "author": "凉菜",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "files": [
        "/lib/**/*.js",
        "/lib/**/*.d.ts",
        "!lib/**/*.spec.*",
        "!lib/**/*.test.*",
        "!lib/**/__tests__/**"
    ],
    "dependencies": {
        "douyin-im": "^1.1.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsc-alias": "1.9.4",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "onebots": "workspace:*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lc-cn/onebots.git"
    }
}
