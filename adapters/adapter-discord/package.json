{
    "name": "@onebots/adapter-discord",
    "version": "3.0.12",
    "description": "onebots Discord 适配器（轻量版，支持 Node.js 和 Cloudflare Workers）",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./lite": {
            "types": "./lib/lite/index.d.ts",
            "default": "./lib/lite/index.js"
        }
    },
    "scripts": {
        "build": "rm -f *.tsbuildinfo && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "clean": "rm -rf lib *.tsbuildinfo"
    },
    "keywords": [
        "onebots",
        "discord",
        "adapter",
        "cloudflare-workers",
        "serverless",
        "lightweight"
    ],
    "author": "凉菜",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "files": [
        "/lib/**/*.js",
        "/lib/**/*.d.ts",
        "!lib/**/*.spec.*",
        "!lib/**/*.test.*",
        "!lib/**/__tests__/**"
    ],
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsc-alias": "latest",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "onebots": "workspace:*"
    },
    "optionalDependencies": {
        "ws": "^8.18.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lc-cn/onebots.git"
    }
}
