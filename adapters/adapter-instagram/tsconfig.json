{
    "compilerOptions": {
        "outDir": "./lib",
        "rootDir": "./src",
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "declaration": true,
        "strict": true,
        "skipLibCheck": true,
        "composite": true
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["./src/**/*.spec.ts"]
}
