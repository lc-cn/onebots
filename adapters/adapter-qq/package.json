{
    "name": "@onebots/adapter-qq",
    "version": "3.0.10",
    "description": "OneBots QQ 官方机器人适配器（基于腾讯官方 Node.js SDK）",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "build": "rm -f *.tsbuildinfo && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "clean": "rm -rf lib *.tsbuildinfo"
    },
    "keywords": [
        "onebots",
        "qq",
        "adapter",
        "qq-bot",
        "qq-guild"
    ],
    "author": "凉菜",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "files": [
        "/lib/**/*.js",
        "/lib/**/*.d.ts",
        "!lib/**/*.spec.*",
        "!lib/**/*.test.*",
        "!lib/**/__tests__/**"
    ],
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsc-alias": "latest",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "onebots": "workspace:*"
    },
    "dependencies": {
        "@tencent-connect/qqbot-nodejs": "^1.0.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lc-cn/onebots.git"
    }
}
