{
    "name": "@onebots/adapter-whatsapp",
    "version": "3.0.10",
    "description": "onebots WhatsApp 适配器",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "build": "rm -rf lib *.tsbuildinfo && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "clean": "rm -rf lib *.tsbuildinfo"
    },
    "keywords": [
        "onebots",
        "whatsapp",
        "adapter"
    ],
    "author": "凉菜",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "files": [
        "/lib/**/*.js",
        "/lib/**/*.d.ts",
        "!lib/**/*.spec.*",
        "!lib/**/*.test.*",
        "!lib/**/__tests__/**"
    ],
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsc-alias": "latest",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "onebots": "workspace:*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lc-cn/onebots.git"
    }
}
