{
  "name": "onebots",
  "version": "1.2.8",
  "description": "OneBots 整合适配器和协议，提供HTTP/WebSocket服务",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "onebots": "./lib/bin.js"
  },
  "scripts": {
    "start": "node lib/bin.js",
    "build": "rm -rf lib && rm -f *.tsbuildinfo && tsc --project tsconfig.json && tsc-alias -p tsconfig.json && cp -r src/config.sample.yaml lib/config.sample.yaml",
    "clean": "rm -rf lib *.tsbuildinfo"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "onebot",
    "qq",
    "wechat",
    "dingtalk",
    "cq-http",
    "multi-protocol"
  ],
  "author": "凉菜",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "/lib/**/*.json",
    "!lib/**/*.spec.*",
    "!lib/**/*.test.*",
    "!lib/**/__tests__/**"
  ],
  "devDependencies": {
    "@types/koa": "^3.0.1",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "tsc-alias": "latest",
    "tsconfig-paths": "latest",
    "tsx": "latest",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@karinjs/node-pty": "^1.1.3",
    "@onebots/core": "workspace:*",
    "@onebots/web": "workspace:*",
    "ink": "^6.3.1",
    "js-yaml": "^4.3.1",
    "koa-static": "^5.0.0",
    "pastel": "^4.0.1",
    "react": "^19.1.1",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lc-cn/onebots.git"
  }
}
