{
    "name": "@onebots/meta",
    "version": "0.1.1",
    "description": "OneBots Meta Graph API 与 Webhook 共享基础层",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        }
    },
    "scripts": {
        "build": "rm -f *.tsbuildinfo && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "clean": "rm -rf lib *.tsbuildinfo"
    },
    "keywords": [
        "onebots",
        "meta",
        "graph-api",
        "messenger",
        "instagram",
        "webhook"
    ],
    "author": "凉菜",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "files": [
        "/lib/**/*.js",
        "/lib/**/*.d.ts",
        "!lib/**/*.spec.*",
        "!lib/**/*.test.*"
    ],
    "dependencies": {
        "@onebots/core": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsc-alias": "latest",
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lc-cn/onebots.git"
    }
}
